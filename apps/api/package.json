    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.12.0",
    "nodemailer": "^7.0.7",
    "otplib": "^12.0.1",
    "zod": "^4.1.0",
    "@fastify/multipart": "^9.3.0",
    "@aws-sdk/client-s3": "^3.925.0",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"

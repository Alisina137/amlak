{
  "name": "amlaklink",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @amlaklink/api dev",
    "dev:mobile": "pnpm --filter @amlaklink/mobile start",
    "dev:admin": "pnpm --filter @amlaklink/admin dev",
    "db:migrate": "pnpm --filter @amlaklink/database migrate",
    "staff:create": "pnpm --filter @amlaklink/api staff:create",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm typecheck && pnpm test",
    "db:diagnose": "pnpm --filter @amlaklink/database diagnose",
    "ops:freshness": "pnpm --filter @amlaklink/api ops:freshness",
    "ops:alerts": "pnpm --filter @amlaklink/api ops:alerts",
    "db:backup": "pnpm --filter @amlaklink/database backup",
    "db:restore:staging": "pnpm --filter @amlaklink/database restore:staging",
    "pilot:smoke": "node scripts/pilot-smoke.mjs"
  }
}

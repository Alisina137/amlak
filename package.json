{
  "name": "amlaklink",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:api": "node scripts/dev-api-with-ngrok.mjs",
    "dev:mobile": "pnpm --filter @amlaklink/mobile start",
    "dev:mobile:push": "pnpm --filter @amlaklink/mobile start:dev-client",
    "dev:admin": "pnpm --filter @amlaklink/admin dev",
    "db:migrate": "pnpm --filter @amlaklink/database migrate",
    "staff:create": "pnpm --filter @amlaklink/api staff:create",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm typecheck && pnpm test",
    "db:diagnose": "pnpm --filter @amlaklink/database diagnose",
    "ops:freshness": "pnpm --filter @amlaklink/api ops:freshness",
    "ops:alerts": "pnpm --filter @amlaklink/api ops:alerts",
    "ops:push": "pnpm --filter @amlaklink/api ops:push",
    "ops:push:preflight": "pnpm --filter @amlaklink/api ops:push:preflight",
    "ops:renewals": "pnpm --filter @amlaklink/api ops:renewals",
    "db:backup": "pnpm --filter @amlaklink/database backup",
    "db:restore:staging": "pnpm --filter @amlaklink/database restore:staging",
    "db:backup:verify": "pnpm --filter @amlaklink/database backup:verify",
    "db:integrity": "pnpm --filter @amlaklink/database integrity",
    "ops:media:audit": "pnpm --filter @amlaklink/api ops:media:audit",
    "pilot:smoke": "node scripts/pilot-smoke.mjs",
    "qa:phase8": "node --test scripts/test-phase8-release-gate.mjs && node scripts/phase8-release-gate.mjs --ci",
    "qa:ui": "node --test scripts/test-final-rtl-ui.mjs",
    "qa:network": "node --test scripts/test-final-network.mjs",
    "qa:renewals": "node --test scripts/test-final-subscriptions.mjs",
    "qa:billing": "node --test scripts/test-final-billing.mjs",
    "qa:release": "node scripts/phase8-release-gate.mjs --release",
    "qa:android-e2e": "node --test scripts/test-final-android-e2e.mjs",
    "qa:kabul-pilot": "node --test scripts/test-final-kabul-pilot.mjs",
    "qa:production-readiness": "node --test scripts/test-final-production-readiness.mjs",
    "qa:integration-verification": "node --test scripts/test-final-integration-verification.mjs"
  }
}

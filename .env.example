# Root template. Copy the relevant values to each application's local .env file.
# Mobile needs a reachable HTTPS URL on physical devices (for example, a tunnel to port 4000).
API_PORT=4000
API_HOST=0.0.0.0
EXPO_PUBLIC_API_URL=
NEXT_PUBLIC_API_URL=http://localhost:4000
# Future phases: DATABASE_URL, identity provider, private media and MFA credentials.
# Never commit actual credentials or production contact data.

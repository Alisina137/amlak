# Copy to repository root .env and fill REAL secrets privately. NEVER COMMIT.
API_PORT=4000
API_HOST=0.0.0.0
DATABASE_URL=
# Default TCP uses port 5432. If blocked, set websocket for Neon only (port 443).
DATABASE_TRANSPORT=tcp
AUTH_CODE_PEPPER=
STAFF_TOTP_ENCRYPTION_KEY_HEX=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Use ONLY on a private development machine, never when exposing the API publicly.
AUTH_DEV_PRINT_CODES=false
AMLAK_API_INTERNAL_URL=http://127.0.0.1:4000
EXPO_PUBLIC_API_URL=

# Production requires S3-compatible storage for property photos.
# Without this, private local development stores optimized photos under .amlak-media.
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_LOCAL_DIR=

# Backup (generate a NEW random 32-byte hex key; never commit):
BACKUP_ENCRYPTION_KEY_HEX=
BACKUP_DIRECTORY=.amlak-backups
# Staging restore only; never point to the production database:
STAGING_DATABASE_URL=
RESTORE_CONFIRM=
